# ใช้เซ็น session/cookie ของ Better Auth — สุ่มด้วย `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# URL ที่ผู้ใช้เข้าเว็บจริง (ใช้สร้าง callback ของ Google) — production ใส่โดเมน tunnel แบบ https
BETTER_AUTH_URL=http://localhost:3200
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# อีเมล Google ของแอดมินระบบ — สร้างบอร์ดและเห็นทุกบอร์ดได้ (คั่นด้วย ,)
ADMIN_EMAILS=
# (optional) ที่เก็บไฟล์ sqlite — ค่าเริ่มต้น ./data
DATA_DIR=./data
